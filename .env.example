# ==============================================================================
# PUDUGAI WELLNESS CENTER (PWC) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.local and fill in your Supabase project credentials.
# Get these values from your Supabase Dashboard: Project Settings -> API.

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon / Public Key (Safe for client-side use)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
